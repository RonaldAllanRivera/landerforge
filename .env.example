# Supabase — use the CURRENT key format. The legacy JWT-shaped anon/service_role keys
# are deprecated at the end of 2026, so there is no reason to adopt them now.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Google OAuth client id/secret are NOT app env vars — they go into the Supabase
# dashboard's Google provider, and Supabase performs the exchange.

ANTHROPIC_API_KEY=sk-ant-...

BROWSERLESS_URL=wss://production-sfo.browserless.io
BROWSERLESS_TOKEN=

INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=
